<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@android:color/white"
    android:paddingBottom="16dp">

    <!-- Título de la sección -->
    <TextView
        android:id="@+id/tvServicios"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="20dp"
        android:text="@string/services_titulo"
        android:textColor="@color/services_texto"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- 3 círculos en CHAIN horizontal (spread): se reparten el ancho solos -->
    <ImageView
        android:id="@+id/imgConsulta"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/services_circulo"
        android:contentDescription="@string/services_consulta"
        android:padding="20dp"
        android:src="@drawable/ic_consulta"
        app:tint="@color/services_azul"
        app:layout_constraintEnd_toStartOf="@id/imgMedicinas"
        app:layout_constraintHorizontal_chainStyle="spread"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvServicios" />

    <ImageView
        android:id="@+id/imgMedicinas"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:background="@drawable/services_circulo"
        android:contentDescription="@string/services_medicinas"
        android:padding="20dp"
        android:src="@drawable/ic_medicinas"
        app:tint="@color/services_azul"
        app:layout_constraintEnd_toStartOf="@id/imgAmbulancia"
        app:layout_constraintStart_toEndOf="@id/imgConsulta"
        app:layout_constraintTop_toTopOf="@id/imgConsulta" />

    <ImageView
        android:id="@+id/imgAmbulancia"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:background="@drawable/services_circulo"
        android:contentDescription="@string/services_ambulancia"
        android:padding="20dp"
        android:src="@drawable/ic_ambulancia"
        app:tint="@color/services_azul"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/imgMedicinas"
        app:layout_constraintTop_toTopOf="@id/imgConsulta" />

    <!-- Textos: cada uno debajo de su círculo y centrado con él (start y end al círculo) -->
    <TextView
        android:id="@+id/tvConsulta"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/services_consulta"
        android:textColor="@color/services_texto"
        android:textSize="13sp"
        app:layout_constraintEnd_toEndOf="@id/imgConsulta"
        app:layout_constraintStart_toStartOf="@id/imgConsulta"
        app:layout_constraintTop_toBottomOf="@id/imgConsulta" />

    <TextView
        android:id="@+id/tvMedicinas"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/services_medicinas"
        android:textColor="@color/services_texto"
        android:textSize="13sp"
        app:layout_constraintEnd_toEndOf="@id/imgMedicinas"
        app:layout_constraintStart_toStartOf="@id/imgMedicinas"
        app:layout_constraintTop_toBottomOf="@id/imgMedicinas" />

    <TextView
        android:id="@+id/tvAmbulancia"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/services_ambulancia"
        android:textColor="@color/services_texto"
        android:textSize="13sp"
        app:layout_constraintEnd_toEndOf="@id/imgAmbulancia"
        app:layout_constraintStart_toStartOf="@id/imgAmbulancia"
        app:layout_constraintTop_toBottomOf="@id/imgAmbulancia" />

</androidx.constraintlayout.widget.ConstraintLayout>
